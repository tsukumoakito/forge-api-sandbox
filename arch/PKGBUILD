# Maintainer: tsukumo-forge-sandbox-lab
pkgname=linux-sandbox
pkgver=7.3.6
pkgrel=1
pkgdesc="Minimal & fastest latest Arch Linux kernel package for CI verification"
arch=('x86_64')
url="https://www.kernel.org/"
license=('GPL-2.0-only')
makedepends=('bc' 'cpio' 'gettext' 'kmod' 'libelf' 'perl' 'python' 'tar' 'xz')
options=('!strip' '!debug')
source=("https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${pkgver}.tar.xz")
sha256sums=('8183d475a76a0faffa92d6cd500af421f589dfd0300a0f1060bb875e11d45723')

prepare() {
    cd "linux-${pkgver}"
    make allnoconfig
    ./scripts/config \
        --enable 64BIT \
        --enable SMP \
        --enable MODULES \
        --enable PRINTK \
        --enable BINFMT_ELF \
        --enable TTY
    make olddefconfig
}

build() {
    cd "linux-${pkgver}"
    make -j"$(nproc)" bzImage modules
}

package() {
    cd "linux-${pkgver}"
    local kver
    kver="$(make -s kernelrelease)"

    install -Dm644 "$(make -s image_name)" "${pkgdir}/usr/lib/modules/${kver}/vmlinuz"
    echo "${pkgname}" | install -Dm644 /dev/stdin "${pkgdir}/usr/lib/modules/${kver}/pkgbase"
    make INSTALL_MOD_PATH="${pkgdir}/usr" INSTALL_MOD_STRIP=1 DEPMOD=/doesnt/exist modules_install
    rm -f "${pkgdir}/usr/lib/modules/${kver}/build" "${pkgdir}/usr/lib/modules/${kver}/source"
}
